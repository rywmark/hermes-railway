{
	admin off
	auto_https off
	persist_config off
}

:{$PORT} {
	encode gzip

	basic_auth /* {
		{$DASHBOARD_USERNAME} {$DASHBOARD_PASSWORD_HASH}
	}

	reverse_proxy 127.0.0.1:9119 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output stderr
		format console
		level INFO
	}
}
