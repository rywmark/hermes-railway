{
	admin off
	auto_https off
	persist_config off
}

:{$PORT} {
	encode gzip

	basic_auth /* {
		{$DASHBOARD_USERNAME} {$DASHBOARD_PASSWORD_HASH}
	}

	reverse_proxy 127.0.0.1:9119 {
		# Hermes dashboard validates Host == its bind address (127.0.0.1).
		# Override the upstream Host so the dashboard accepts the request,
		# but preserve the original public host in X-Forwarded-Host.
		header_up Host 127.0.0.1:9119
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stderr
		format console
		level INFO
	}
}
